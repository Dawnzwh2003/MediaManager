{
    "$schema":  "../gen/schemas/desktop-schema.json",
    "identifier":  "main",
    "description":  "Local media library, read-only viewers, activity recording and bounded statistics jobs.",
    "local":  true,
    "windows":  [
                    "main"
                ],
    "permissions":  [
                        "allow-get-app-status",
                        "allow-query-library",
                        "allow-get-media-details",
                        "allow-list-library-tags",
                        "allow-mutate-custom-tag",
                        "allow-get-thumbnails",
                        "allow-open-viewer",
                        "allow-close-viewer",
                        "allow-save-playback-state",
                        "allow-prepare-playback",
                        "allow-viewer-navigation",
                        "allow-get-playback-state",
                        "core:event:allow-listen",
                        "core:event:allow-unlisten",
                        "core:window:allow-destroy",
                        "allow-add-like",
        "allow-get-statistics",
                        "allow-activate-media",
                        "allow-open-player-session",
                        "allow-report-playback",
                        "allow-close-activity",
                        "allow-rebuild-statistics",
                        "allow-statistics-job",
                        "allow-cancel-statistics-rebuild"
                    ]
}
